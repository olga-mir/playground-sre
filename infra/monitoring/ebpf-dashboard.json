    {
      "filterType": "VALUE_ONLY",
      "labelKey": "",
      "stringValue": "pod/VICTIM_UID/.+",
      "templateVariable": "victim_cgroup",
      "valueType": "STRING"
    },
    {
      "filterType": "VALUE_ONLY",
      "labelKey": "",
      "stringValue": "pod/BULLY_UID/.+",
      "templateVariable": "bully_cgroup",
      "valueType": "STRING"
    }
  ],
